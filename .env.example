# Copy to .env.local for local development. Never commit .env.local.
# These are public-by-design browser identifiers (they end up in the bundle).
# Never put a real secret in a VITE_ variable.

# Run the whole app on sample data, no Google setup needed.
VITE_USE_MOCK=true

# Repository name, used as the Vite base path on GitHub Pages (e.g. "household").
VITE_BASE=

# Google OAuth client ID (Web application), Picker API key and Cloud project number.
HH_GOOGLE_CLIENT_ID=
HH_PICKER_API_KEY=
HH_GOOGLE_PROJECT_NUMBER=
